# Copy this file to .env and fill in only what you need.
# The CLI loads .env from the current directory without overriding existing
# process environment variables. Every value below is optional unless noted.
# Never commit a real API key.

# ---------- General ----------
# Output file OR directory. Default: current directory + sanitized video title.
# BV_SUMMARY_OUTPUT=./outputs
# BV_SUMMARY_KEEP_AUDIO=false
# BV_SUMMARY_SAVE_RAW=false
# BV_SUMMARY_FORCE=false

# Optional explicit config file and ffmpeg binary.
# BV_SUMMARY_CONFIG=./config.toml
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe

# ---------- Download ----------
# YTDLP_COOKIES=C:\path\to\cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome

# ---------- ASR ----------
# auto = local faster-whisper first, then OpenAI-compatible API if configured.
# Other values: faster-whisper, openai
ASR_BACKEND=auto
ASR_MODEL=small
# auto picks CUDA when available, otherwise CPU. Use cpu to force CPU.
ASR_DEVICE=auto
# auto -> a CTranslate2-supported type (int8 on CPU; float16/int8 variants on
# CUDA depending on the GPU). Other common values: int8, float16, float32.
ASR_COMPUTE_TYPE=auto
# auto / empty = language detection. Examples: zh, en, ja.
ASR_LANGUAGE=auto
# Optional local directory or Hugging Face model id for faster-whisper.
# ASR_MODEL_DIR=
# ASR_CPU_THREADS=0
# ASR_BEAM_SIZE=5

# Online ASR fallback / explicit backend:
# ASR_BACKEND=openai
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_API_MODEL=whisper-1
# ASR_API_KEY=sk-...
# ASR_API_KEY can fall back to OPENAI_API_KEY.
# ASR_CHUNK_SECONDS=600
# ASR_TIMEOUT=600

# ---------- LLM correction ----------
# auto = configured OpenAI-compatible target first, then reachable local Ollama.
# Other values: openai, ollama, none
LLM_BACKEND=auto
# Model name is required unless you use --llm-backend none.
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# A common fallback key shared by ASR and LLM:
# OPENAI_API_KEY=sk-...
# LLM_TEMPERATURE=0.1
# LLM_CHUNK_CHARS=3000
# LLM_TIMEOUT=120
# LLM_PROMPT_FILE=./prompts/correct.txt

# Local Ollama fallback (OpenAI-compatible endpoint):
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b
